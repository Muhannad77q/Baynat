[
  {
    "index": 1,
    "hemistich_a": "تَسَامَى فُؤَادِي بِالْوَفَاءِ وَسَبَّحَا",
    "hemistich_b": "وَأَشْرَقَ نُورُ الْحَقِّ فِي النَّفْسِ وَانْمَحَى",
    "start": 4.5,
    "mid": 10.160181405895692,
    "end": 18.179274376417233,
    "a_end": 10.160181405895692,
    "b_start": 10.710181405895693
  },
  {
    "index": 2,
    "hemistich_a": "إِلَى اللهِ يَمْشِي السَّالِكُونَ بِهِمَّةٍ",
    "hemistich_b": "وَمَنْ حَسَّنَ الأَخْلاَقَ بِالْفَوْزِ أَفْلَحَا",
    "start": 18.529274376417234,
    "mid": 25.06809523809524,
    "end": 32.857573696145124,
    "a_end": 25.06809523809524,
    "b_start": 25.61809523809524
  },
  {
    "index": 3,
    "hemistich_a": "هِيَ الْمَرْقَاةُ لِلْقُرْبَى، سُلَّمُ رِفْعَةٍ",
    "hemistich_b": "تَزِيْدُ بِهَا الأَرْوَاحُ نُوراً وَمَطْمَحَا",
    "start": 33.207573696145126,
    "mid": 39.72938775510204,
    "end": 47.29142857142857,
    "a_end": 39.72938775510204,
    "b_start": 40.27938775510204
  },
  {
    "index": 4,
    "hemistich_a": "فَلَيْسَ عُلُوَّ الْمَرْءِ فِي جَاهِ دُنْيَةٍ",
    "hemistich_b": "وَلَكِنْ بِقَلْبٍ فِي التَّقَى قَدْ أَطْمَحَا",
    "start": 47.64142857142857,
    "mid": 53.86412698412698,
    "end": 61.492290249433104,
    "a_end": 53.86412698412698,
    "b_start": 54.41412698412698
  },
  {
    "index": 5,
    "hemistich_a": "بِلِيْنِ كَلاَمٍ، وَابْتِسَامَةِ صَادِقٍ",
    "hemistich_b": "وَبِالْحِلْمِ حِينَ الْجَهْلُ يَغْلُو وَيَطْمَحَا",
    "start": 61.842290249433105,
    "mid": 67.99979591836734,
    "end": 75.46272108843537,
    "a_end": 67.99979591836734,
    "b_start": 68.54979591836735
  },
  {
    "index": 6,
    "hemistich_a": "وَتَرَاهُ يَنْهَضُ لِلشَّهَامَةِ بَاسِلاً",
    "hemistich_b": "يَحْمِي الكَرَامَةَ صَادِقاً وَمُكَافِحَا",
    "start": 75.81272108843537,
    "mid": 81.47385487528344,
    "end": 88.67913832199547,
    "a_end": 81.47385487528344,
    "b_start": 82.02385487528343
  },
  {
    "index": 7,
    "hemistich_a": "نَفْسٌ أَبِيَّةُ لاَ تُقِرُّ هَوَانَهَا",
    "hemistich_b": "تَطْوِي الصِّعَابَ إِذَا الخَطُوبُ تَكَالَحَا",
    "start": 89.02913832199546,
    "mid": 94.75120181405896,
    "end": 102.79793650793651,
    "a_end": 94.75120181405896,
    "b_start": 95.30120181405896
  },
  {
    "index": 8,
    "hemistich_a": "يَسْعى بِنَخْوَتِهِ لِنَصْرَةِ عَاجِزٍ",
    "hemistich_b": "وَيَخُوضُ فِي الإِقْدَامِ بَحْراً أَلْفَحَا",
    "start": 103.1479365079365,
    "mid": 108.75786848072562,
    "end": 116.27873015873016,
    "a_end": 108.75786848072562,
    "b_start": 109.30786848072562
  },
  {
    "index": 9,
    "hemistich_a": "فَمَنْ حَازَ حُسْنَ الْخُلْقِ حَازَ مَقَامَهُ",
    "hemistich_b": "وَعَاشَ بِرَوْضَاتِ الرِّضَا مُنْشَرِحَا",
    "start": 116.62873015873015,
    "mid": 122.96979591836734,
    "end": 129.78696145124715,
    "a_end": 122.96979591836734,
    "b_start": 123.51979591836734
  },
  {
    "index": 10,
    "hemistich_a": "هُوَ الشَّرَفُ الأَسْمَى لِكُلِّ مُوَحِّدٍ",
    "hemistich_b": "يُرَاجِي جِوَارَ اللهِ يَوْماً وَمَنْنَحَا",
    "start": 130.13696145124715,
    "mid": 136.7856462585034,
    "end": 143.82961451247164,
    "a_end": 136.7856462585034,
    "b_start": 137.33564625850337
  },
  {
    "index": 11,
    "hemistich_a": "أَمَاطَ الأَذَى عَنْ دَرْبِهِ فَتَكَرَّمَتْ",
    "hemistich_b": "سَجَايَاهُ، بَالْخَيْرَاتِ بَشَّ وَأَوْضَحَا",
    "start": 144.17961451247163,
    "mid": 150.09242630385484,
    "end": 157.60664399092968,
    "a_end": 150.09242630385484,
    "b_start": 150.64242630385485
  },
  {
    "index": 12,
    "hemistich_a": "يَكُفُّ لِسَانَ السُّوءِ عَنْ كُلِّ مُسْلِمٍ",
    "hemistich_b": "وَإِنْ سِيءَ يَوْماً بِالْجَمِيلِ تَصَفَّحَا",
    "start": 157.95664399092968,
    "mid": 164.80920634920633,
    "end": 172.2378684807256,
    "a_end": 164.80920634920633,
    "b_start": 165.35920634920632
  },
  {
    "index": 13,
    "hemistich_a": "يَجُودُ بِكُفَّيْهِ وَيَبْسُطُ بِشْرَهُ",
    "hemistich_b": "وَيَمْشِي بِتَوْحِيدِ الإِلَهِ مُكَبِّرَا",
    "start": 172.5878684807256,
    "mid": 177.9969841269841,
    "end": 184.87365079365077,
    "a_end": 177.9969841269841,
    "b_start": 178.5469841269841
  },
  {
    "index": 14,
    "hemistich_a": "صَلاَةٌ بِأَعْمَاقِ الدَّجَى فِي خَفِيَّةٍ",
    "hemistich_b": "وَدَمْعُ خُشُوعٍ فِي الطَّهَارَةِ سَحَّحَا",
    "start": 185.22365079365076,
    "mid": 191.60714285714283,
    "end": 199.39879818594102,
    "a_end": 191.60714285714283,
    "b_start": 192.15714285714282
  },
  {
    "index": 15,
    "hemistich_a": "وَطَاعَاتُ سِرٍّ لاَ يُرَاهَا سِوَى الَّذِي",
    "hemistich_b": "يَرَى الصَّادِقَ الأَوَّاهَ فِيمَا اسْتَشْرَحَا",
    "start": 199.748798185941,
    "mid": 206.5281632653061,
    "end": 214.5285714285714,
    "a_end": 206.5281632653061,
    "b_start": 207.0781632653061
  },
  {
    "index": 16,
    "hemistich_a": "فَتِلْكَ النَّوَافِلُ كُلُّهَا مَرَقَاتُهُ",
    "hemistich_b": "تُقَرِّبُهُ حَتَّى يُزَادَ وَيُمْنَحَا",
    "start": 214.8785714285714,
    "mid": 220.5925623582766,
    "end": 227.25603174603174,
    "a_end": 220.5925623582766,
    "b_start": 221.14256235827662
  },
  {
    "index": 17,
    "hemistich_a": "يُحِبُّ لِأَهْلِ الأَرْضِ مَا شَاءَ لِلنَّوَى",
    "hemistich_b": "فَلاَ غِلَّ فِي الأَحْشَاءِ جَالَ وَأَقْفَحَا",
    "start": 227.60603174603173,
    "mid": 234.06603174603174,
    "end": 242.16895691609977,
    "a_end": 234.06603174603174,
    "b_start": 234.61603174603172
  },
  {
    "index": 18,
    "hemistich_a": "وَيَشْفَعُ لِلْمُخْطِي، وَيَصْفَحُ عَفْوَةً",
    "hemistich_b": "فَسُبْحَانَ مَنْ بِالْعَفْوِ زَادَهُ مَمْنَحَا",
    "start": 242.51895691609977,
    "mid": 248.6557596371882,
    "end": 255.8962358276644,
    "a_end": 248.6557596371882,
    "b_start": 249.2057596371882
  },
  {
    "index": 19,
    "hemistich_a": "تَرَاهُ قَرِيباً مِنْ بَشِيرِ مُحَمَّدٍ",
    "hemistich_b": "بِأَحْسَنِهِمْ خُلْقاً، جِوَاراً وَمَطْمَحَا",
    "start": 256.2462358276644,
    "mid": 262.2157369614512,
    "end": 269.72215419501134,
    "a_end": 262.2157369614512,
    "b_start": 262.76573696145124
  },
  {
    "index": 20,
    "hemistich_a": "جِوَارَ نَبِيِّ اللهِ فِي خُلْدِ رَبِّهِ",
    "hemistich_b": "فَيَا طِيبَ مَنْ فِي ذَا الْجِوَارِ المُرَبَّحَا",
    "start": 270.07215419501136,
    "mid": 275.9939002267574,
    "end": 284.27331065759637,
    "a_end": 275.9939002267574,
    "b_start": 276.5439002267574
  },
  {
    "index": 21,
    "hemistich_a": "يُرَقِّيهِ حُسْنُ الْخُلْقِ فِي جَنَّاتِهِ",
    "hemistich_b": "دَرَجَاتِ قُرْبٍ، بَارِقاً وَمُسَبِّحَا",
    "start": 284.6233106575964,
    "mid": 290.5822448979592,
    "end": 297.4933560090703,
    "a_end": 290.5822448979592,
    "b_start": 291.1322448979592
  },
  {
    "index": 22,
    "hemistich_a": "يَعْلُو صُعُوداً فِي المَرَاقِي مُكَرَّماً",
    "hemistich_b": "تُسَلِّمُ أَمْلاَكُ السَّمَاءِ وَتَفْرَحَا",
    "start": 297.8433560090703,
    "mid": 304.08092970521545,
    "end": 311.320589569161,
    "a_end": 304.08092970521545,
    "b_start": 304.6309297052154
  },
  {
    "index": 23,
    "hemistich_a": "يَرَى لَذَّةَ الْقُرْبَى بِأَعْلَى جِنَانِهَا",
    "hemistich_b": "فَيَسْكُنُ فِرْدَوْساً نَضِيراً وَأَفْيَحَا",
    "start": 311.670589569161,
    "mid": 317.64696145124714,
    "end": 324.5348072562358,
    "a_end": 317.64696145124714,
    "b_start": 318.19696145124715
  },
  {
    "index": 24,
    "hemistich_a": "مَنَازِلُ لِلأَخْلاَقِ تُبْنَى بِرِفْعَةٍ",
    "hemistich_b": "وَلَيْسَ يُوَافِيهَا الَّذِي كَانَ شُحَّحَا",
    "start": 324.88480725623583,
    "mid": 330.51167800453516,
    "end": 338.2127891156462,
    "a_end": 330.51167800453516,
    "b_start": 331.06167800453517
  },
  {
    "index": 25,
    "hemistich_a": "يَنَالُ بِهَا الإِنْسَانُ مَا لَمْ يَنَلْهُ فِي",
    "hemistich_b": "قِيَامِ طَوِيلٍ أَوْ صِيَامٍ تَصَفَّحَا",
    "start": 338.56278911564624,
    "mid": 345.4343537414966,
    "end": 352.6781405895691,
    "a_end": 345.4343537414966,
    "b_start": 345.9843537414966
  },
  {
    "index": 26,
    "hemistich_a": "فَإِنَّ وِزَانَ الْخُلْقِ ثَقَّلَ مِيزَانَهُ",
    "hemistich_b": "فَيَا لَكُ أَمْراً فِي المَوَازِينِ أَرْجَحَا",
    "start": 353.02814058956915,
    "mid": 359.08832199546487,
    "end": 366.7976643990929,
    "a_end": 359.08832199546487,
    "b_start": 359.6383219954648
  },
  {
    "index": 27,
    "hemistich_a": "حَيَاةُ الفَتَى يَوْمٌ يُمِرُّ سَرِيعَهُ",
    "hemistich_b": "فَسَارِعْ لإِحْسَانٍ إِذَا المَجْدُ أَلْمَحَا",
    "start": 367.14766439909295,
    "mid": 373.2475283446712,
    "end": 380.7695011337868,
    "a_end": 373.2475283446712,
    "b_start": 373.79752834467115
  },
  {
    "index": 28,
    "hemistich_a": "وَاجْعَلْ صَنَائِعَكَ الجَمِيلَةَ سُلَّماً",
    "hemistich_b": "لِتَبْلُغَ بَابَ العَرْشِ نُوراً وَأَرْوَحَا",
    "start": 381.1195011337868,
    "mid": 386.81206349206343,
    "end": 394.16229024943306,
    "a_end": 386.81206349206343,
    "b_start": 387.36206349206344
  },
  {
    "index": 29,
    "hemistich_a": "فَيَا فَوْزَ مَنْ جَعَلَ المَكَارِمَ سُلَّماً",
    "hemistich_b": "وَمَرِقَاةَ قُرْبٍ لِلْمَلِيْكِ، فَأُنْجِحَا",
    "start": 394.5122902494331,
    "mid": 400.96396825396823,
    "end": 408.17907029478454,
    "a_end": 400.96396825396823,
    "b_start": 401.51396825396824
  }
]